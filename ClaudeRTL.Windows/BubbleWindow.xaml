<Window x:Class="ClaudeRTL.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude RTL"
        Width="360"
        Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border Background="#2E2A27"
            BorderBrush="#3A3531"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <TextBlock x:Name="PlainText"
                   TextWrapping="Wrap"
                   Foreground="#F4F3EE"
                   FontSize="16"
                   FlowDirection="RightToLeft"
                   TextAlignment="Right" />
    </Border>
</Window>
