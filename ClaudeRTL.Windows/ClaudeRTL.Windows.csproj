<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <AssemblyName>ClaudeRTL</AssemblyName>
    <RootNamespace>ClaudeRTL</RootNamespace>
    <Version>1.1.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- WinSparkle native auto-updater. The x64 WinSparkle.dll is downloaded once into
       native/ (gitignored) and copied next to the executable for DllImport to resolve. -->
  <PropertyGroup>
    <WinSparkleVersion>0.8.1</WinSparkleVersion>
    <WinSparkleNativeDir>$(MSBuildProjectDirectory)\native</WinSparkleNativeDir>
    <WinSparkleDll>$(WinSparkleNativeDir)\WinSparkle.dll</WinSparkleDll>
  </PropertyGroup>

  <Target Name="FetchWinSparkle" BeforeTargets="BeforeBuild;BeforePublish">
    <MakeDir Directories="$(WinSparkleNativeDir)" />
    <DownloadFile Condition="!Exists('$(WinSparkleDll)')"
                  SourceUrl="https://github.com/vslavik/winsparkle/releases/download/v$(WinSparkleVersion)/WinSparkle-$(WinSparkleVersion).zip"
                  DestinationFolder="$(WinSparkleNativeDir)"
                  Retries="3">
      <Output TaskParameter="DownloadedFile" PropertyName="WinSparkleZipPath" />
    </DownloadFile>
    <Unzip Condition="!Exists('$(WinSparkleDll)') and '$(WinSparkleZipPath)' != ''"
           SourceFiles="$(WinSparkleZipPath)"
           DestinationFolder="$(WinSparkleNativeDir)\unzipped" />
    <ItemGroup Condition="!Exists('$(WinSparkleDll)')">
      <_WinSparkleX64 Include="$(WinSparkleNativeDir)\unzipped\**\x64\Release\WinSparkle.dll" />
    </ItemGroup>
    <Copy Condition="!Exists('$(WinSparkleDll)') and '@(_WinSparkleX64)' != ''"
          SourceFiles="@(_WinSparkleX64)"
          DestinationFolder="$(WinSparkleNativeDir)" />
  </Target>

  <Target Name="CopyWinSparkleToOutput" AfterTargets="Build" DependsOnTargets="FetchWinSparkle">
    <Copy Condition="Exists('$(WinSparkleDll)')"
          SourceFiles="$(WinSparkleDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWinSparkleToPublish" AfterTargets="Publish" DependsOnTargets="FetchWinSparkle">
    <Copy Condition="Exists('$(WinSparkleDll)')"
          SourceFiles="$(WinSparkleDll)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
