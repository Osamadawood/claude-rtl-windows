<Window x:Class="ClaudeRTL.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Claude RTL"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image x:Name="IconImage"
               Grid.Row="0"
               Width="48"
               Height="48"
               HorizontalAlignment="Center"
               Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Text="Claude RTL"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="VersionText"
                   Grid.Row="2"
                   FontSize="13"
                   Foreground="#666666"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <Button Grid.Row="3"
                Content="by GRW Lab — grwlab.net"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                Foreground="#C25F3D"
                FontSize="13"
                FontWeight="Medium"
                Cursor="Hand"
                Click="OnOpenWebsite" />

        <TextBlock Grid.Row="4"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="12"
                   Foreground="#666666"
                   VerticalAlignment="Center"
                   Text="Claude RTL is an independent tool from GRW Lab. It is not affiliated with, endorsed by, or supported by Anthropic. “Claude” is a trademark of Anthropic." />

        <Button Grid.Row="5"
                Content="OK"
                Width="80"
                Height="32"
                HorizontalAlignment="Center"
                IsDefault="True"
                Click="OnClose" />
    </Grid>
</Window>
